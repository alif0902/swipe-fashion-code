# Transaction pooler (port 6543) — dipakai aplikasi saat runtime.
# Wajib pooler, bukan direct, karena Vercel berjalan serverless.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"

# Direct connection (port 5432) — hanya dipakai drizzle-kit push dan seed.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Untuk pengembangan lokal dengan Postgres dari Homebrew, keduanya sama:
# DATABASE_URL="postgresql://USER@localhost:5432/swipefash"
# DIRECT_URL="postgresql://USER@localhost:5432/swipefash"

# Kunci penandatangan sesi login. Buat nilai acak sendiri:
#   openssl rand -base64 32
# Wajib diisi juga di Vercel (Settings -> Environment Variables); kalau tidak,
# build produksi gagal dengan pesan dari lib/auth.ts.
BETTER_AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"

# Opsional. Kosongkan saja — di Vercel URL deployment dipakai otomatis, dan di
# lokal Better Auth memakai origin permintaan.
# BETTER_AUTH_URL="http://localhost:20100"
