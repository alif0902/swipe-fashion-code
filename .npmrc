# ============================================================================
# KEAMANAN: jangan jalankan install script paket pihak ketiga
# ============================================================================
#
# Repo ini sebelumnya memakai pnpm, yang punya allowlist eksplisit
# (`onlyBuiltDependencies`) sehingga hanya paket tertentu boleh menjalankan
# build script saat install. npm tidak punya allowlist seperti itu — pilihannya
# hanya semua atau tidak sama sekali.
#
# Install script adalah jalur masuk utama serangan supply-chain npm: satu paket
# transitif yang dikompromikan bisa menjalankan kode sembarang di mesinmu saat
# `npm install`. Jadi kita matikan semuanya.
#
# Konsekuensinya, paket yang memang butuh kompilasi native harus di-build
# manual SETELAH install:
#
#     npm install
#     npm run rebuild:native      # esbuild + sharp
#
# `npm run rebuild:native` adalah pengganti allowlist pnpm — daftar paket yang
# kita percaya ada di script itu, bukan tersebar di node_modules.
#
# JANGAN setel ini ke false. Kalau ada paket baru yang butuh build script,
# tambahkan namanya ke script `rebuild:native` di package.json root.
ignore-scripts=true

# npm 7+ memasang peer dependency otomatis. Repo ini menyematkan React tepat
# di 19.1.0, jadi resolusi otomatis dibiarkan apa adanya dan konflik peer
# ditangani manual, bukan disembunyikan dengan legacy-peer-deps.
legacy-peer-deps=false

# Audit tetap berjalan saat install supaya kerentanan yang diketahui terlihat.
audit=true
